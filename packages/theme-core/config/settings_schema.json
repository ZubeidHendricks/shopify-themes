      { "type": "color", "id": "color_foreground", "label": "Text", "default": "#1a1a1a" },
      { "type": "color", "id": "color_accent", "label": "Accent / buttons", "default": "#1a1a1a" },
      { "type": "color", "id": "color_accent_text", "label": "Accent text", "default": "#ffffff" }
    ]
  },
  {

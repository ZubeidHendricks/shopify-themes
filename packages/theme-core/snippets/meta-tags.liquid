{%- comment -%} Open Graph + Twitter card meta tags, shared across all themes. {%- endcomment -%}
<meta property="og:site_name" content="{{ shop.name }}">
<meta property="og:url" content="{{ canonical_url }}">
<meta property="og:title" content="{{ page_title }}">
<meta property="og:type" content="{% if request.page_type == 'product' %}product{% elsif request.page_type == 'article' %}article{% else %}website{% endif %}">
{%- if page_description %}
  <meta property="og:description" content="{{ page_description | escape }}">
{%- endif %}
{%- if page_image %}
  <meta property="og:image" content="http:{{ page_image | image_url: width: 1200 }}">
  <meta property="og:image:width" content="1200">
{%- endif %}
<meta name="twitter:card" content="summary_large_image">
<meta name="twitter:title" content="{{ page_title }}">
{%- if settings.social_twitter_handle != blank %}
  <meta name="twitter:site" content="{{ settings.social_twitter_handle }}">
{%- endif %}

<div class="search section">
  <div class="page-width">
    <h1>{{ 'general.search.search' | t }}</h1>
    <form action="{{ routes.search_url }}" method="get" role="search" class="search__form">
      <input type="search" name="q" value="{{ search.terms | escape }}" placeholder="{{ 'general.search.placeholder' | t }}">
      <button type="submit" class="button">{{ 'general.search.search' | t }}</button>
    </form>

    {%- if search.performed -%}
      {%- if search.results_count > 0 -%}
        <p class="search__count">{{ 'general.search.results_count' | t: count: search.results_count }}</p>
        <div class="grid grid--4">
          {%- for item in search.results -%}
            {%- if item.object_type == 'product' -%}
              {% render 'product-card', product: item %}
            {%- else -%}
              <div class="search__result"><a href="{{ item.url }}"><h3>{{ item.title }}</h3></a></div>
            {%- endif -%}
          {%- endfor -%}
        </div>
      {%- else -%}
        <p>{{ 'general.search.no_results' | t: terms: search.terms }}</p>
      {%- endif -%}
    {%- endif -%}
  </div>
</div>

{% stylesheet %}
  .search__form { display: flex; gap: 0.5rem; max-width: 32rem; margin: 1rem 0 2rem; }
  .search__form input { flex: 1; }
{% endstylesheet %}

{% schema %}
{ "name": "Search results", "settings": [] }
{% endschema %}

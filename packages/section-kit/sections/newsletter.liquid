<div class="newsletter-section section" style="text-align: center;">
  <div class="page-width newsletter-section__inner">
    {%- if section.settings.heading != blank -%}<h2>{{ section.settings.heading }}</h2>{%- endif -%}
    {%- if section.settings.subtext != blank -%}<p>{{ section.settings.subtext }}</p>{%- endif -%}
    {% render 'newsletter-form' %}
  </div>
</div>

{% stylesheet %}
  .newsletter-section__inner { max-width: 36rem; margin: 0 auto; display: grid; gap: 1rem; }
  .newsletter-form__row { display: flex; gap: 0.5rem; justify-content: center; }
  .newsletter-form__row input { flex: 1; max-width: 20rem; }
{% endstylesheet %}

{% schema %}
{
  "name": "Newsletter",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading", "default": "Join our list" },
    { "type": "text", "id": "subtext", "label": "Subtext", "default": "Get 10% off your first order." }
  ],
  "presets": [{ "name": "Newsletter" }]
}
{% endschema %}

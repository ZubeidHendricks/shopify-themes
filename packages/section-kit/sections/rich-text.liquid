<div class="rich-text section">
  <div class="page-width rich-text__inner" style="text-align: {{ section.settings.text_align }};">
    {%- for block in section.blocks -%}
      {%- case block.type -%}
        {%- when 'heading' -%}
          <h2 {{ block.shopify_attributes }}>{{ block.settings.heading }}</h2>
        {%- when 'text' -%}
          <div class="rte" {{ block.shopify_attributes }}>{{ block.settings.text }}</div>
        {%- when 'button' -%}
          <a href="{{ block.settings.link }}" class="button" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
      {%- endcase -%}
    {%- endfor -%}
  </div>
</div>

{% stylesheet %}
  .rich-text__inner { max-width: 48rem; margin: 0 auto; display: grid; gap: 1rem; justify-items: var(--rich-justify, center); }
{% endstylesheet %}

{% schema %}
{
  "name": "Rich text",
  "settings": [
    { "type": "select", "id": "text_align", "label": "Alignment", "default": "center",
      "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }] }
  ],
  "blocks": [
    { "type": "heading", "name": "Heading", "limit": 1,
      "settings": [{ "type": "text", "id": "heading", "label": "Heading", "default": "Talk about your brand" }] },
    { "type": "text", "name": "Text",
      "settings": [{ "type": "richtext", "id": "text", "label": "Text", "default": "<p>Use this section to share your story, values, or what makes your products special.</p>" }] },
    { "type": "button", "name": "Button",
      "settings": [
        { "type": "text", "id": "label", "label": "Label", "default": "Learn more" },
        { "type": "url", "id": "link", "label": "Link" }
      ] }
  ],
  "presets": [{ "name": "Rich text", "blocks": [{ "type": "heading" }, { "type": "text" }] }]
}
{% endschema %}

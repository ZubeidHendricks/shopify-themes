<div class="password section">
  <div class="page-width password__inner">
    {%- if section.settings.logo != blank -%}
      {{ section.settings.logo | image_url: width: 360 | image_tag: loading: 'eager', alt: shop.name, class: 'password__logo' }}
    {%- else -%}
      <h1 class="password__name">{{ shop.name }}</h1>
    {%- endif -%}

    {%- if section.settings.heading != blank -%}<p class="password__heading">{{ section.settings.heading }}</p>{%- endif -%}

    {% form 'storefront_password' %}
      {%- if form.errors -%}
        <p class="password__error">{{ form.errors.translated_fields.password | capitalize }} {{ form.errors.messages.password }}</p>
      {%- endif -%}
      <div class="password__row">
        <label class="visually-hidden" for="Password">Password</label>
        <input type="password" id="Password" name="password" placeholder="Password" required>
        <button type="submit" class="button">Enter</button>
      </div>
    {% endform %}

    <p class="password__note"><small>Are you the store owner? <a href="/admin">Log in here</a>.</small></p>
  </div>
</div>

{% stylesheet %}
  .password { min-height: 80vh; display: grid; place-items: center; text-align: center; }
  .password__inner { display: grid; gap: 1rem; justify-items: center; max-width: 28rem; }
  .password__logo { max-width: 240px; }
  .password__row { display: flex; gap: 0.5rem; }
  .password__error { color: #c0392b; }
{% endstylesheet %}

{% schema %}
{
  "name": "Password",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "text", "id": "heading", "label": "Heading", "default": "Opening soon" }
  ]
}
{% endschema %}

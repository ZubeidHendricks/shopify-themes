<footer class="footer section">
  <div class="page-width footer__inner grid grid--3">
    {%- for block in section.blocks -%}
      <div class="footer__block" {{ block.shopify_attributes }}>
        {%- case block.type -%}
          {%- when 'text' -%}
            {%- if block.settings.heading != blank -%}<h3>{{ block.settings.heading }}</h3>{%- endif -%}
            <div class="rte">{{ block.settings.body }}</div>
          {%- when 'menu' -%}
            {%- if block.settings.heading != blank -%}<h3>{{ block.settings.heading }}</h3>{%- endif -%}
            <ul class="footer__menu">
              {%- for link in block.settings.menu.links -%}
                <li><a href="{{ link.url }}">{{ link.title }}</a></li>
              {%- endfor -%}
            </ul>
          {%- when 'newsletter' -%}
            {%- if block.settings.heading != blank -%}<h3>{{ block.settings.heading }}</h3>{%- endif -%}
            {% render 'newsletter-form' %}
        {%- endcase -%}
      </div>
    {%- endfor -%}
  </div>
  <div class="page-width footer__bottom">
    <small>&copy; {{ 'now' | date: '%Y' }} {{ shop.name }}</small>
  </div>
</footer>

{% stylesheet %}
  .footer__menu { list-style: none; margin: 0; padding: 0; display: grid; gap: 0.4rem; }
  .footer__menu a { text-decoration: none; }
  .footer__bottom { margin-top: 2rem; opacity: 0.7; }
{% endstylesheet %}

{% schema %}
{
  "name": "Footer",
  "blocks": [
    {
      "type": "menu",
      "name": "Menu",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shop" },
        { "type": "link_list", "id": "menu", "label": "Menu", "default": "footer" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "About" },
        { "type": "richtext", "id": "body", "label": "Text", "default": "<p>Tell customers about your brand.</p>" }
      ]
    },
    {
      "type": "newsletter",
      "name": "Newsletter",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Newsletter" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Footer",
      "blocks": [{ "type": "menu" }, { "type": "text" }, { "type": "newsletter" }]
    }
  ]
}
{% endschema %}

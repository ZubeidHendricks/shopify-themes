<div class="list-collections section">
  <div class="page-width">
    <h1>{{ page_title }}</h1>
    <div class="grid grid--3">
      {%- for collection in collections -%}
        <a href="{{ collection.url }}" class="collection-card">
          <div class="collection-card__media">
            {%- if collection.featured_image -%}
              {{ collection.featured_image | image_url: width: 600 | image_tag: loading: 'lazy', widths: '300, 600', alt: collection.title }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: '' }}
            {%- endif -%}
          </div>
          <h3>{{ collection.title }}</h3>
        </a>
      {%- endfor -%}
    </div>
  </div>
</div>

{% stylesheet %}
  .collection-card { text-decoration: none; display: block; }
  .collection-card__media img { width: 100%; aspect-ratio: 4/3; object-fit: cover; border-radius: var(--inputs-radius); }
{% endstylesheet %}

{% schema %}
{ "name": "Collections list", "settings": [] }
{% endschema %}

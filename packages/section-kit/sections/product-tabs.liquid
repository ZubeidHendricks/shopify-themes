{%- comment -%}
  Product tabs. Blocks let the merchant mix the product description with
  page-backed content (shipping, care, sizing) without editing Liquid.
  Progressive enhancement: with no JS this renders as stacked <details>.
{%- endcomment -%}
{%- if section.blocks.size > 0 -%}
<div class="section product-tabs" data-product-tabs>
  <div class="page-width">
    {%- for block in section.blocks -%}
      <details class="product-tabs__item" {% if forloop.first %}open{% endif %} {{ block.shopify_attributes }}>
        <summary class="product-tabs__summary">
          {{- block.settings.heading | default: block.settings.page.title -}}
        </summary>
        <div class="product-tabs__panel rte">
          {%- case block.type -%}
            {%- when 'description' -%}
              {{ product.description }}
            {%- when 'page' -%}
              {{ block.settings.page.content }}
            {%- else -%}
              {{ block.settings.content }}
          {%- endcase -%}
        </div>
      </details>
    {%- endfor -%}
  </div>
</div>
{%- endif -%}

{% schema %}
{
  "name": "Product tabs",
  "tag": "section",
  "class": "section-product-tabs",
  "enabled_on": { "templates": ["product"] },
  "blocks": [
    {
      "type": "description",
      "name": "Description",
      "limit": 1,
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Description" }
      ]
    },
    {
      "type": "page",
      "name": "Page",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading" },
        { "type": "page", "id": "page", "label": "Page" }
      ]
    },
    {
      "type": "text",
      "name": "Text",
      "settings": [
        { "type": "text", "id": "heading", "label": "Heading", "default": "Shipping & returns" },
        { "type": "richtext", "id": "content", "label": "Content" }
      ]
    }
  ],
  "presets": [
    {
      "name": "Product tabs",
      "blocks": [{ "type": "description" }, { "type": "text" }]
    }
  ]
}
{% endschema %}

{%- assign uid = section.id | replace: '-', '_' -%}
<div class="slideshow section" id="Slideshow-{{ uid }}"
     data-autoplay="{{ section.settings.autoplay }}" data-interval="{{ section.settings.interval | times: 1000 }}">
  <div class="slideshow__track">
    {%- for block in section.blocks -%}
      <div class="slideshow__slide{% if forloop.first %} is-active{% endif %}" data-slide {{ block.shopify_attributes }}>
        {%- if forloop.first -%}{%- assign slide_loading = 'eager' -%}{%- else -%}{%- assign slide_loading = 'lazy' -%}{%- endif -%}
        <div class="slideshow__media">
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 2000 | image_tag:
                loading: slide_loading, widths: '750, 1100, 1500, 2000', sizes: '100vw',
                class: 'slideshow__image', alt: block.settings.heading | default: shop.name }}
          {%- else -%}
            {{ 'lifestyle-1' | placeholder_svg_tag: 'slideshow__image' }}
          {%- endif -%}
        </div>
        <div class="slideshow__content page-width" style="text-align: {{ block.settings.text_align }};">
          {%- if block.settings.heading != blank -%}<h2 class="slideshow__heading">{{ block.settings.heading }}</h2>{%- endif -%}
          {%- if block.settings.text != blank -%}<p class="slideshow__text">{{ block.settings.text }}</p>{%- endif -%}
          {%- if block.settings.button_label != blank -%}
            <a href="{{ block.settings.button_link }}" class="button">{{ block.settings.button_label }}</a>
          {%- endif -%}
        </div>
      </div>
    {%- endfor -%}
  </div>

  {%- if section.blocks.size > 1 -%}
    <div class="slideshow__dots" role="tablist">
      {%- for block in section.blocks -%}
        <button type="button" class="slideshow__dot{% if forloop.first %} is-active{% endif %}" data-dot="{{ forloop.index0 }}" aria-label="Slide {{ forloop.index }}"></button>
      {%- endfor -%}
    </div>
  {%- endif -%}
</div>

<script>
  (function () {
    var root = document.getElementById('Slideshow-{{ uid }}');
    if (!root) return;
    var slides = root.querySelectorAll('[data-slide]');
    var dots = root.querySelectorAll('[data-dot]');
    if (slides.length < 2) return;
    var index = 0, timer = null;
    function show(i) {
      index = (i + slides.length) % slides.length;
      slides.forEach(function (s, n) { s.classList.toggle('is-active', n === index); });
      dots.forEach(function (d, n) { d.classList.toggle('is-active', n === index); });
    }
    dots.forEach(function (d) { d.addEventListener('click', function () { show(parseInt(d.dataset.dot, 10)); restart(); }); });
    function restart() {
      if (root.dataset.autoplay !== 'true') return;
      clearInterval(timer);
      timer = setInterval(function () { show(index + 1); }, parseInt(root.dataset.interval, 10) || 5000);
    }
    restart();
  })();
</script>

{% stylesheet %}
  .slideshow { position: relative; }
  .slideshow__slide { display: none; position: relative; }
  .slideshow__slide.is-active { display: grid; }
  .slideshow__media, .slideshow__content { grid-area: 1 / 1; }
  .slideshow__image { width: 100%; height: 100%; min-height: 340px; max-height: 72vh; object-fit: cover; }
  .slideshow__content { position: relative; align-self: center; padding: 2rem 1.5rem; color: #fff; text-shadow: 0 1px 12px rgba(0,0,0,0.4); display: grid; gap: 1rem; justify-items: start; }
  .slideshow__heading { font-size: clamp(1.8rem, 4vw, 3rem); }
  .slideshow__dots { position: absolute; bottom: 1rem; left: 0; right: 0; display: flex; gap: 0.5rem; justify-content: center; }
  .slideshow__dot { width: 10px; height: 10px; border-radius: 50%; border: 0; background: rgba(255,255,255,0.5); cursor: pointer; }
  .slideshow__dot.is-active { background: #fff; }
{% endstylesheet %}

{% schema %}
{
  "name": "Slideshow",
  "settings": [
    { "type": "checkbox", "id": "autoplay", "label": "Auto-rotate", "default": true },
    { "type": "range", "id": "interval", "label": "Change every", "min": 3, "max": 10, "step": 1, "unit": "s", "default": 5 }
  ],
  "blocks": [
    {
      "type": "slide", "name": "Slide",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Image" },
        { "type": "text", "id": "heading", "label": "Heading", "default": "Slide headline" },
        { "type": "text", "id": "text", "label": "Text", "default": "Supporting copy for this slide." },
        { "type": "text", "id": "button_label", "label": "Button label", "default": "Shop now" },
        { "type": "url", "id": "button_link", "label": "Button link" },
        { "type": "select", "id": "text_align", "label": "Alignment", "default": "left",
          "options": [{ "value": "left", "label": "Left" }, { "value": "center", "label": "Center" }] }
      ]
    }
  ],
  "presets": [
    { "name": "Slideshow", "blocks": [{ "type": "slide" }, { "type": "slide" }] }
  ]
}
{% endschema %}

{% layout none %}
<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    {%- assign gc_value = gift_card.initial_value | money -%}
    <title>{{ shop.name }} gift card — {{ gc_value }}</title>
    {% render 'css-variables' %}
    {{ 'base.css' | asset_url | stylesheet_tag }}
    {{ content_for_header }}
  </head>
  <body class="template-gift-card">
    <main class="page-width" style="max-width: 32rem; margin: 3rem auto; text-align: center; display: grid; gap: 1.5rem;">
      <h1>{{ shop.name }}</h1>
      <p>Here's your gift card!</p>

      <div class="gift-card__amount" style="font-size: 2.5rem; font-family: var(--font-heading-family);">
        {{ gift_card.balance | money }}
      </div>

      {%- assign qr = gift_card.qr_identifier | default: gift_card.code -%}
      <img
        src="{{ 'gift-card/qr-code.png' | shopify_asset_url }}?id={{ qr }}"
        alt="QR code"
        style="margin: 0 auto;"
        width="120" height="120">

      <div class="gift-card__code"
           style="font-size: 1.25rem; letter-spacing: 0.1em; padding: 0.75rem 1rem; border: 1px dashed rgba(var(--color-foreground), 0.4); border-radius: var(--inputs-radius);">
        {{ gift_card.code | format_code }}
      </div>

      {%- if gift_card.expired -%}
        <p style="color: #c0392b;">This gift card has expired.</p>
      {%- elsif gift_card.expires_on -%}
        <p><small>Expires {{ gift_card.expires_on | date: '%B %-d, %Y' }}</small></p>
      {%- endif -%}

      <a href="{{ shop.url }}" class="button">Visit store</a>
    </main>
  </body>
</html>
